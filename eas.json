{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "testflight": {
      "distribution": "store",
      "ios": {
        "simulator": false
      },
      "env": {
        "APP_VARIANT": "testflight"
      }
    },
    "production": {
      "distribution": "store"
    }
  },
}
